{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat-japan-government-information/government-information-request-output/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "jurisdiction", "topic", "question", "status", "sources", "unresolved_fields", "constraints"],
  "properties": {
    "schema": { "const": "hathq://hat-japan-government-information/government-information-request-output/v1" },
    "jurisdiction": { "const": "JP" },
    "topic": { "enum": ["laws", "tax", "statistics", "administration"] },
    "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "administrative_area_code": { "type": "string", "pattern": "^JP-(0[1-9]|[1-3][0-9]|4[0-7])$" },
    "as_of_date": { "type": "string", "format": "date" },
    "status": { "enum": ["prepared", "needs-user-input"] },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "publisher", "origin", "topic", "access"],
        "properties": {
          "id": { "type": "string" },
          "publisher": { "type": "string" },
          "origin": { "type": "string", "format": "uri" },
          "topic": { "enum": ["laws", "tax", "statistics", "administration"] },
          "access": { "enum": ["public-https", "public-https-or-registered-api"] }
        }
      }
    },
    "unresolved_fields": { "type": "array", "uniqueItems": true, "items": { "enum": ["administrative-area", "as-of-date"] } },
    "constraints": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["official-sources-only", "no-legal-interpretation", "no-tax-determination", "preserve-source-and-time", "do-not-fill-unresolved"] }
    }
  }
}
